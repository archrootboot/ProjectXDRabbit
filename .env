#OPTIONS(ADMIN)
APP_PACKAGE=com.view.ytrabbit
APP_MAIN_ACTIVITY=com.view.ytrabbit.activity.HomeActiviy
NEW_COMMAND_TIMEOUT = 1000
ADB_EXEC_TIMEOUT=60000
UIAUTOMATOR2_SERVER_LAUNCH_TIMEOUT=60000
WEBDRIVER_URL=http://127.0.0.1:4723


#OPTIONS(USER)

#
#WATCH_TIME_VALUES=60      → duration == 60
#WATCH_TIME_VALUES=60,90   → duration in 60,90
#WATCH_TIME_VALUES=<60     → duration < 60
#WATCH_TIME_VALUES=>60     → duration > 60
#WATCH_TIME_VALUES=<=60    → duration <= 60
#WATCH_TIME_VALUES=>=60    → duration >= 60
#WATCH_TIME_VALUES=        → all videos
WATCH_TIME_VALUES =
#>=250

#Max watch other skip count - default 10 if not set
MAX_SKIPS=10

#Max point not updated error count - default 10 if not set
MAX_POINT_ERRORS = 3
#Max point not updated error time window in seconds - default 1800 if not set
MAX_POINT_ERROR_TIME = 300

#Max seconds to wait for a running video to finish before adding campaign - default 300 if not set
CAMPAIGN_PAUSE_TIMEOUT = 1000

#Thumbnail image format for skip_thumbs/ folder (png or jpg)
THUMB_IMAGE_EXT=jpg

#Thumbnail quality: maxresdefault | sddefault | hqdefault | mqdefault | default
THUMB_QUALITY=sddefault

#Threshold for image hash comparison (lower is more strict)
AHASH_THRESHOLD = 8
WHASH_THRESHOLD  = 12